# Copy this file to a new file named .env and fill it in. Never share or upload .env.

# Needed for the AI tutor (console.anthropic.com)
ANTHROPIC_API_KEY=

# Needed so every language can be spoken. Set Google, or Azure, or both.
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# For quick personal testing only (unofficial): set to 1 to hear every language without any key.
# FREE_TEST_VOICE=1

# A long random string (32 or more characters). Signs login tokens. Required in production.
SESSION_SECRET=

MODEL=claude-sonnet-5-5
PORT=3000
# Set these two when you put the site on the internet:
# NODE_ENV=production
# TRUST_PROXY=1
